generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  userPCs       UserPC[]
  checks        CheckHistory[]
}

model UserPC {
  id        String   @id @default(cuid())
  userId    String
  name      String
  cpu       String
  gpu       String
  ram       Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Game {
  id         String         @id @default(cuid())
  title      String         @unique
  slug       String         @unique
  coverUrl   String?
  minCpu     String?
  minGpu     String?
  minRam     Int?
  benchmarks Benchmark[]
  checks     CheckHistory[]
}

model Benchmark {
  id         String   @id @default(cuid())
  gameId     String
  gpu        String
  cpu        String?
  ram        Int?
  fpsAvg     Int
  setting    String
  youtubeUrl String?
  notes      String?

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model CheckHistory {
  id        String   @id @default(cuid())
  userId    String?
  gameId    String
  parsedCpu String
  parsedGpu String
  parsedRam Int
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  game Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
}